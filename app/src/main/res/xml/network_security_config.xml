<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is for a coach model on this phone or the local network, which Android can't list by address range; Connection.baseUrlOf keeps every other address on https. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
